{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-tech-hero",
  "main": "worker.js",
  "compatibility_date": "2026-09-11",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "redact_query_string": true
  },
  "vars": {
    "CONTACT_FROM_EMAIL": "request@mytechhero.net",
    "CONTACT_TO_EMAIL": "request@mytechhero.net"
  },
"assets": {
  "directory": "./dist",
  "binding": "ASSETS",
  "not_found_handling": "single-page-application",
  "run_worker_first": [
    "/api/*"
  ]
},
  "routes": [
    {
      "pattern": "mytechhero.net",
      "custom_domain": true
    }
  ]
}